{
  "rewrites": [
    {
      "source": "/api/stocks",
      "destination": "/api/stocks"
    },
    {
      "source": "/api/stocks/analyze",
      "destination": "/api/analyze"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/15 * * * *"
    }
  ]
}
