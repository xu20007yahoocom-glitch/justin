# GEMINI_API_KEY: Required for Gemini AI API calls (stock analysis feature).
# If unset, the app falls back to rich offline/simulated analysis so it
# never breaks the UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this app is hosted (used in outgoing Telegram
# alert messages as the "🔗 Live Dashboard:" link, both in the scheduled
# cron alert and the manual "Send Test Alert" button). Must be set
# EXPLICITLY on Vercel — Vercel does NOT auto-provide a stable production
# URL under this exact name. If APP_URL is left unset on Vercel, the code
# falls back to Vercel's own auto-injected VERCEL_URL env var (a bare host
# like "my-app.vercel.app", auto-upgraded to "https://..."), so the link
# is never blank — but APP_URL is still recommended so the link always
# points to your custom/production domain rather than a preview-deployment
# URL. On Cloud Run, set this to your service URL, e.g.
# "https://ais-dev-xxx.run.app".
APP_URL="MY_APP_URL"

# --- Telegram push notifications (used by /api/whatsapp/* and /api/cron) ---
# These are optional defaults used only if no settings have been saved yet
# via the in-app "WhatsApp Notifications" (Telegram) config panel.
# TELEGRAM_BOT_TOKEN: Bot token obtained from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Destination chat/user/channel ID to receive alerts.
TELEGRAM_CHAT_ID=""

# CRON_SECRET: Optional shared secret to protect /api/cron from being
# triggered by anyone other than Vercel's own Cron Jobs scheduler.
# Vercel automatically sends this as `Authorization: Bearer <CRON_SECRET>`
# when set as a Vercel Cron Job. Generate any random string.
CRON_SECRET=""
